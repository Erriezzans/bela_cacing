<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<FrameLayout android:layout_width="250dp" android:layout_height="312dp"
    android:layout_gravity="center">
<ViewFlipper android:id="@+id/flip" android:layout_width="180dp"
    android:layout_height="177dp" android:layout_marginStart="35dp"
    android:layout_marginTop="14dp" android:autoStart="true"
    android:flipInterval="400">
<ImageView android:id="@+id/f1" android:layout_width="match_parent"
    android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f2" android:layout_width="match_parent"
    android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f3" android:layout_width="match_parent"
    android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f4" android:layout_width="match_parent"
    android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f5" android:layout_width="match_parent"
    android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f6" android:layout_width="match_parent"
    android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f7" android:layout_width="match_parent"
    android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f8" android:layout_width="match_parent"
    android:layout_height="match_parent" android:src="@drawable/w_idle"/>
</ViewFlipper>
<TextView android:id="@+id/menu_tag" android:layout_width="120dp"
    android:layout_height="24dp" android:layout_marginStart="65dp"
    android:layout_marginTop="0dp" android:gravity="center"
    android:background="@drawable/panel_bg" android:visibility="gone"
    android:textSize="14sp" android:textStyle="bold"
    android:textColor="#FFFFFF"/>
<FrameLayout android:layout_width="238dp" android:layout_height="70dp"
    android:layout_marginStart="6dp" android:layout_marginTop="194dp"
    android:background="@drawable/panel_bg">
<LinearLayout android:layout_width="match_parent"
    android:layout_height="32dp" android:layout_marginTop="5dp"
    android:orientation="horizontal">
<TextView android:id="@+id/stat_h" android:layout_width="0dp"
    android:layout_height="match_parent" android:layout_weight="1"
    android:gravity="center" android:textSize="11sp"
    android:textColor="#FFFFFF"/>
<TextView android:id="@+id/stat_j" android:layout_width="0dp"
    android:layout_height="match_parent" android:layout_weight="1"
    android:gravity="center" android:textSize="11sp"
    android:textColor="#FFFFFF"/>
<TextView android:id="@+id/stat_s" android:layout_width="0dp"
    android:layout_height="match_parent" android:layout_weight="1"
    android:gravity="center" android:textSize="11sp"
    android:textColor="#FFFFFF"/>
</LinearLayout>
<TextView android:id="@+id/info" android:layout_width="match_parent"
    android:layout_height="15dp" android:layout_marginTop="37dp"
    android:gravity="center" android:textSize="11sp"
    android:textColor="#FFFFFF"/>
<TextView android:id="@+id/note" android:layout_width="match_parent"
    android:layout_height="15dp" android:layout_marginTop="52dp"
    android:gravity="center" android:textSize="11sp"
    android:textStyle="bold" android:textColor="#FFE08A"/>
</FrameLayout>
<TextView android:id="@+id/btn_a" android:layout_width="72dp"
    android:layout_height="40dp" android:layout_marginStart="6dp"
    android:layout_marginTop="268dp" android:gravity="center"
    android:text="A  next" android:textSize="12sp" android:textStyle="bold"
    android:textColor="#FFFFFF" android:background="@drawable/btn_worm"/>
<TextView android:id="@+id/btn_b" android:layout_width="72dp"
    android:layout_height="40dp" android:layout_marginStart="89dp"
    android:layout_marginTop="268dp" android:gravity="center"
    android:text="B  pick" android:textSize="12sp" android:textStyle="bold"
    android:textColor="#FFFFFF" android:background="@drawable/btn_worm"/>
<TextView android:id="@+id/btn_c" android:layout_width="72dp"
    android:layout_height="40dp" android:layout_marginStart="172dp"
    android:layout_marginTop="268dp" android:gravity="center"
    android:text="C  back" android:textSize="12sp" android:textStyle="bold"
    android:textColor="#FFFFFF" android:background="@drawable/btn_worm"/>
</FrameLayout>
</FrameLayout>
