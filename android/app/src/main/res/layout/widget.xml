<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent">
<FrameLayout android:layout_width="250dp" android:layout_height="297dp"
 android:layout_gravity="center">
<ViewFlipper android:id="@+id/flip" android:layout_width="190dp"
 android:layout_height="187dp" android:layout_marginStart="30dp"
 android:autoStart="true" android:flipInterval="450">
<ImageView android:id="@+id/f1" android:layout_width="match_parent"
 android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f2" android:layout_width="match_parent"
 android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f3" android:layout_width="match_parent"
 android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f4" android:layout_width="match_parent"
 android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f5" android:layout_width="match_parent"
 android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f6" android:layout_width="match_parent"
 android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f7" android:layout_width="match_parent"
 android:layout_height="match_parent" android:src="@drawable/w_idle"/>
<ImageView android:id="@+id/f8" android:layout_width="match_parent"
 android:layout_height="match_parent" android:src="@drawable/w_idle"/>
</ViewFlipper>
<TextView android:id="@+id/menu_tag" android:layout_width="120dp"
 android:layout_height="28dp" android:layout_marginStart="65dp"
 android:layout_marginTop="8dp" android:gravity="center"
 android:background="@drawable/panel_bg" android:visibility="gone"
 android:textSize="15sp" android:textStyle="bold"
 android:textColor="#FFFFFF"/>
<TextView android:id="@+id/panel" android:layout_width="238dp"
 android:layout_height="58dp" android:layout_marginStart="6dp"
 android:layout_marginTop="191dp" android:padding="7dp"
 android:background="@drawable/panel_bg" android:maxLines="3"
 android:ellipsize="end" android:textSize="11sp"
 android:textColor="#FFFFFF"/>
<TextView android:id="@+id/btn_a" android:layout_width="72dp"
 android:layout_height="40dp" android:layout_marginStart="6dp"
 android:layout_marginTop="253dp" android:gravity="center"
 android:text="A  next" android:textSize="12sp" android:textStyle="bold"
 android:textColor="#FFFFFF" android:background="@drawable/btn_worm"/>
<TextView android:id="@+id/btn_b" android:layout_width="72dp"
 android:layout_height="40dp" android:layout_marginStart="89dp"
 android:layout_marginTop="253dp" android:gravity="center"
 android:text="B  pick" android:textSize="12sp" android:textStyle="bold"
 android:textColor="#FFFFFF" android:background="@drawable/btn_worm"/>
<TextView android:id="@+id/btn_c" android:layout_width="72dp"
 android:layout_height="40dp" android:layout_marginStart="172dp"
 android:layout_marginTop="253dp" android:gravity="center"
 android:text="C  back" android:textSize="12sp" android:textStyle="bold"
 android:textColor="#FFFFFF" android:background="@drawable/btn_worm"/>
</FrameLayout>
</FrameLayout>
